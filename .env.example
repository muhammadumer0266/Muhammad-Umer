# Copy to .env for local development. Never commit the real .env file.
# Values below are safe fakes / defaults, not real secrets.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True

# The canonical public URL of the site. Drives canonical redirects, JSON-LD,
# sitemaps and OG tags. Change once a real domain is bought.
SITE_URL=http://localhost:8000

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# postgres://user:password@localhost:5432/portfolio (Postgres+pgvector in prod/CI)
# sqlite:///db.sqlite3 is fine for a quick first local run only.
DATABASE_URL=sqlite:///db.sqlite3

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Loaded from env, never hard-coded into templates. Shown publicly only if
# Profile.public_email_visible is true; the contact form is the primary path.
CONTACT_EMAIL=muhammadumer0266@gmail.com

# Non-default admin path, kept secret. django-axes + django-otp protect it.
ADMIN_URL=admin-portal-change-me/
# Optional zero-trust network gate: comma-separated IPs/CIDRs allowed to even
# see the admin (everyone else gets a 404). Empty = no network restriction.
ADMIN_ALLOWED_IPS=
# Require a TOTP code for admin login. Defaults to True in production; enroll
# first with: python manage.py enroll_admin_otp <username>
ADMIN_REQUIRE_OTP=False

# Reverse proxies in front of Django (Caddy = 1 in production, 0 locally).
# Used to find the real client IP for rate limits and login lockouts.
TRUSTED_PROXY_COUNT=0

# docker-compose only: required, no default.
POSTGRES_PASSWORD=change-me

# AI ("Ask") feature — undecided provider as of 2026-09-30 (see docs/TODO_OWNER.md).
# Leave unset to use the FakeProvider (no cost, used in tests and local dev).
AI_PROVIDER=fake
AI_DAILY_BUDGET_USD=0
# Rebuild the Ask index automatically when content changes in the admin.
AI_AUTO_REINDEX=True

# Observability
SENTRY_DSN=
DJANGO_LOG_LEVEL=INFO

# Verification (set once the owner has these; meta tags render only if present)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
