# Copy to .env for local development. Never commit the real .env file.
# Values below are safe fakes / defaults, not real secrets.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True

# The canonical public URL of the site. Drives canonical redirects, JSON-LD,
# sitemaps and OG tags. Change once a real domain is bought.
SITE_URL=http://localhost:8000

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# postgres://user:password@localhost:5432/portfolio (Postgres+pgvector in prod/CI)
# sqlite:///db.sqlite3 is fine for a quick first local run only.
DATABASE_URL=sqlite:///db.sqlite3

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Loaded from env, never hard-coded into templates. Shown publicly only if
# Profile.public_email_visible is true; the contact form is the primary path.
CONTACT_EMAIL=muhammadumer0266@gmail.com

# Non-default admin path, kept secret. django-axes + django-otp protect it (M9).
ADMIN_URL=admin-portal-change-me/

# AI ("Ask") feature — undecided provider as of 2026-09-30 (see docs/TODO_OWNER.md).
# Leave unset to use the FakeProvider (no cost, used in tests and local dev).
AI_PROVIDER=fake
AI_DAILY_BUDGET_USD=0

# Observability
SENTRY_DSN=
DJANGO_LOG_LEVEL=INFO

# Verification (set once the owner has these; meta tags render only if present)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
